### 2. .gitignore

```gitignore
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints

# Dataset (large file)
training.1600000.processed.noemoticon.csv
*.zip
data.zip
tmp.zip
trainingandtestdata.zip

# Model files
*.joblib
*.pkl
*.pickle

# Plots & images
*.png
*.jpg
*.jpeg
*.svg
early_stopping*.png
loss_curve*.png

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp